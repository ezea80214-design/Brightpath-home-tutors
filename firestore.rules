rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'eobiagelianthonia@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTutor() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/tutors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.active == true;
    }

    function isAssignedTutorForStudent(parentId) {
      return isTutor() &&
        exists(/databases/$(database)/documents/students/$(parentId)) &&
        get(/databases/$(database)/documents/students/$(parentId)).data.assignedTutorUid == request.auth.uid;
    }

    function isValidParentProfile(data, parentId) {
      return data.keys().hasAll([
        'parentUid',
        'displayName',
        'email',
        'childName',
        'studentClass',
        'assignedTutor',
        'registeredAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'parentUid',
        'displayName',
        'email',
        'childName',
        'studentClass',
        'assignedTutor',
        'assignedTutorUid',
        'registeredAt',
        'updatedAt'
      ]) &&
      data.parentUid is string &&
      data.parentUid == parentId &&
      data.parentUid.size() >= 1 &&
      data.parentUid.size() <= 128 &&
      data.parentUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 150 &&
      data.childName is string &&
      data.childName.size() >= 1 &&
      data.childName.size() <= 100 &&
      data.studentClass is string &&
      data.studentClass.size() >= 1 &&
      data.studentClass.size() <= 60 &&
      data.assignedTutor is string &&
      data.assignedTutor.size() >= 1 &&
      data.assignedTutor.size() <= 100 &&
      (!('assignedTutorUid' in data) || (
        data.assignedTutorUid is string &&
        data.assignedTutorUid.size() >= 1 &&
        data.assignedTutorUid.size() <= 128 &&
        data.assignedTutorUid.matches('^[a-zA-Z0-9_\\-]+$')
      )) &&
      data.registeredAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudentRoster(data, studentId) {
      return data.keys().hasAll([
        'studentId',
        'parentUid',
        'studentName',
        'studentClass',
        'parentName',
        'assignedTutor',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'studentId',
        'parentUid',
        'studentName',
        'studentClass',
        'parentName',
        'assignedTutor',
        'assignedTutorUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.studentId is string &&
      data.studentId == studentId &&
      data.studentId.size() >= 1 &&
      data.studentId.size() <= 128 &&
      data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.parentUid is string &&
      data.parentUid == studentId &&
      data.parentUid.size() >= 1 &&
      data.parentUid.size() <= 128 &&
      data.parentUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentName is string &&
      data.studentName.size() >= 1 &&
      data.studentName.size() <= 100 &&
      data.studentClass is string &&
      data.studentClass.size() >= 1 &&
      data.studentClass.size() <= 60 &&
      data.parentName is string &&
      data.parentName.size() >= 1 &&
      data.parentName.size() <= 100 &&
      data.assignedTutor is string &&
      data.assignedTutor.size() >= 1 &&
      data.assignedTutor.size() <= 100 &&
      (!('assignedTutorUid' in data) || (
        data.assignedTutorUid is string &&
        data.assignedTutorUid.size() >= 1 &&
        data.assignedTutorUid.size() <= 128 &&
        data.assignedTutorUid.matches('^[a-zA-Z0-9_\\-]+$')
      )) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidTutorAccount(data, tutorId) {
      return data.keys().hasAll([
        'tutorUid',
        'displayName',
        'email',
        'specialty',
        'active',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'tutorUid',
        'displayName',
        'email',
        'specialty',
        'active',
        'createdAt',
        'updatedAt'
      ]) &&
      data.tutorUid is string &&
      data.tutorUid == tutorId &&
      data.tutorUid.size() >= 1 &&
      data.tutorUid.size() <= 128 &&
      data.tutorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 150 &&
      data.specialty is string &&
      data.specialty.size() >= 1 &&
      data.specialty.size() <= 120 &&
      data.active is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProgressReport(data, parentId) {
      return data.keys().hasAll([
        'parentUid',
        'studentName',
        'subject',
        'term',
        'assessmentScore',
        'tutorName',
        'tutorNotes',
        'nextFocus',
        'reportDate',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'parentUid',
        'tutorUid',
        'studentName',
        'subject',
        'term',
        'assessmentScore',
        'tutorName',
        'tutorNotes',
        'nextFocus',
        'attachmentTitle',
        'attachmentUrl',
        'reportDate',
        'status',
        'parentReply',
        'createdAt',
        'updatedAt'
      ]) &&
      data.parentUid is string &&
      data.parentUid == parentId &&
      data.parentUid.size() >= 1 &&
      data.parentUid.size() <= 128 &&
      data.parentUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      (!('tutorUid' in data) || (
        data.tutorUid is string &&
        data.tutorUid.size() >= 1 &&
        data.tutorUid.size() <= 128 &&
        data.tutorUid.matches('^[a-zA-Z0-9_\\-]+$')
      )) &&
      data.studentName is string &&
      data.studentName.size() >= 1 &&
      data.studentName.size() <= 100 &&
      data.subject is string &&
      data.subject.size() >= 1 &&
      data.subject.size() <= 80 &&
      data.term is string &&
      data.term.size() >= 1 &&
      data.term.size() <= 60 &&
      data.assessmentScore is number &&
      data.assessmentScore >= 0 &&
      data.assessmentScore <= 100 &&
      data.tutorName is string &&
      data.tutorName.size() >= 1 &&
      data.tutorName.size() <= 100 &&
      data.tutorNotes is string &&
      data.tutorNotes.size() >= 1 &&
      data.tutorNotes.size() <= 1500 &&
      data.nextFocus is string &&
      data.nextFocus.size() >= 1 &&
      data.nextFocus.size() <= 400 &&
      (!('attachmentTitle' in data) || (
        data.attachmentTitle is string &&
        data.attachmentTitle.size() >= 1 &&
        data.attachmentTitle.size() <= 120
      )) &&
      (!('attachmentUrl' in data) || (
        data.attachmentUrl is string &&
        data.attachmentUrl.size() >= 8 &&
        data.attachmentUrl.size() <= 300 &&
        data.attachmentUrl.matches('^https://.*$')
      )) &&
      data.reportDate is string &&
      data.reportDate.size() == 10 &&
      data.reportDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.status in ['Published', 'Acknowledged'] &&
      (!('parentReply' in data) || (data.parentReply is string && data.parentReply.size() <= 500)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSessionLog(data, parentId) {
      return data.keys().hasAll([
        'parentUid',
        'tutorUid',
        'tutorName',
        'studentName',
        'subject',
        'sessionDate',
        'durationMinutes',
        'attendance',
        'topicsCovered',
        'homeworkAssigned',
        'sessionNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'parentUid',
        'tutorUid',
        'tutorName',
        'studentName',
        'subject',
        'sessionDate',
        'durationMinutes',
        'attendance',
        'topicsCovered',
        'homeworkAssigned',
        'sessionNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.parentUid is string &&
      data.parentUid == parentId &&
      data.parentUid.size() >= 1 &&
      data.parentUid.size() <= 128 &&
      data.parentUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.tutorUid is string &&
      data.tutorUid.size() >= 1 &&
      data.tutorUid.size() <= 128 &&
      data.tutorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.tutorName is string &&
      data.tutorName.size() >= 1 &&
      data.tutorName.size() <= 100 &&
      data.studentName is string &&
      data.studentName.size() >= 1 &&
      data.studentName.size() <= 100 &&
      data.subject is string &&
      data.subject.size() >= 1 &&
      data.subject.size() <= 80 &&
      data.sessionDate is string &&
      data.sessionDate.size() == 10 &&
      data.sessionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.durationMinutes is number &&
      data.durationMinutes >= 15 &&
      data.durationMinutes <= 240 &&
      data.attendance in ['Completed', 'Rescheduled', 'Missed'] &&
      data.topicsCovered is string &&
      data.topicsCovered.size() >= 1 &&
      data.topicsCovered.size() <= 800 &&
      data.homeworkAssigned is string &&
      data.homeworkAssigned.size() >= 1 &&
      data.homeworkAssigned.size() <= 500 &&
      data.sessionNotes is string &&
      data.sessionNotes.size() >= 1 &&
      data.sessionNotes.size() <= 1000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /tutors/{tutorId} {
      allow get: if isValidId(tutorId) && (isOwner(tutorId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(tutorId) &&
        isValidTutorAccount(incoming(), tutorId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(tutorId) &&
        isValidTutorAccount(incoming(), tutorId) &&
        incoming().tutorUid == existing().tutorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(tutorId);
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isOwner(studentId) ||
        isAdmin() ||
        (isTutor() && existing().assignedTutorUid == request.auth.uid)
      );
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.parentUid == request.auth.uid) ||
        (isTutor() && resource.data.assignedTutorUid == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudentRoster(incoming(), studentId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(studentId) &&
            incoming().parentUid == request.auth.uid &&
            !('assignedTutorUid' in incoming())
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudentRoster(incoming(), studentId) &&
        incoming().studentId == existing().studentId &&
        incoming().parentUid == existing().parentUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(studentId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName',
              'studentClass',
              'parentName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(studentId);
    }

    match /parents/{parentId} {
      allow get: if isValidId(parentId) && (isOwner(parentId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(parentId) &&
        isValidParentProfile(incoming(), parentId) &&
        incoming().registeredAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(parentId) &&
            incoming().parentUid == request.auth.uid &&
            !('assignedTutorUid' in incoming())
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(parentId) &&
        isValidParentProfile(incoming(), parentId) &&
        incoming().parentUid == existing().parentUid &&
        incoming().registeredAt == existing().registeredAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(parentId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'childName',
              'studentClass',
              'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(parentId);

      match /progressReports/{reportId} {
        allow get: if isValidId(parentId) && isValidId(reportId) && (
          isOwner(parentId) ||
          isAdmin() ||
          (existing().tutorUid == request.auth.uid && isAssignedTutorForStudent(parentId))
        );
        allow list: if (isOwner(parentId) && resource.data.parentUid == request.auth.uid) ||
          isAdmin() ||
          (isTutor() && resource.data.tutorUid == request.auth.uid);

        allow create: if isVerifiedUser() &&
          isValidId(parentId) &&
          isValidId(reportId) &&
          isValidProgressReport(incoming(), parentId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/parents/$(parentId)) &&
          (
            isAdmin() ||
            (isOwner(parentId) && incoming().parentUid == request.auth.uid && !('tutorUid' in incoming())) ||
            (
              ('tutorUid' in incoming()) &&
              incoming().tutorUid == request.auth.uid &&
              incoming().status == 'Published' &&
              !('parentReply' in incoming()) &&
              isAssignedTutorForStudent(parentId)
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(parentId) &&
          isValidId(reportId) &&
          isValidProgressReport(incoming(), parentId) &&
          incoming().parentUid == existing().parentUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              isOwner(parentId) &&
              existing().status != 'Acknowledged' &&
              incoming().status == 'Acknowledged' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'parentReply',
                'status',
                'updatedAt'
              ])
            ) ||
            (
              existing().status != 'Acknowledged' &&
              ('tutorUid' in existing()) &&
              existing().tutorUid == request.auth.uid &&
              incoming().tutorUid == existing().tutorUid &&
              isAssignedTutorForStudent(parentId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'studentName',
                'subject',
                'term',
                'assessmentScore',
                'tutorName',
                'tutorNotes',
                'nextFocus',
                'attachmentTitle',
                'attachmentUrl',
                'reportDate',
                'updatedAt'
              ])
            )
          );

        allow delete: if isAdmin() && isValidId(parentId) && isValidId(reportId);
      }

      match /sessionLogs/{logId} {
        allow get: if isValidId(parentId) && isValidId(logId) && (
          isOwner(parentId) ||
          isAdmin() ||
          (existing().tutorUid == request.auth.uid && isAssignedTutorForStudent(parentId))
        );
        allow list: if (isOwner(parentId) && resource.data.parentUid == request.auth.uid) ||
          isAdmin() ||
          (isTutor() && resource.data.tutorUid == request.auth.uid);

        allow create: if isVerifiedUser() &&
          isValidId(parentId) &&
          isValidId(logId) &&
          isValidSessionLog(incoming(), parentId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/parents/$(parentId)) &&
          (
            isAdmin() ||
            (
              incoming().tutorUid == request.auth.uid &&
              isAssignedTutorForStudent(parentId)
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(parentId) &&
          isValidId(logId) &&
          isValidSessionLog(incoming(), parentId) &&
          incoming().parentUid == existing().parentUid &&
          incoming().tutorUid == existing().tutorUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              existing().tutorUid == request.auth.uid &&
              isAssignedTutorForStudent(parentId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'tutorName',
                'studentName',
                'subject',
                'sessionDate',
                'durationMinutes',
                'attendance',
                'topicsCovered',
                'homeworkAssigned',
                'sessionNotes',
                'updatedAt'
              ])
            )
          );

        allow delete: if isAdmin() && isValidId(parentId) && isValidId(logId);
      }
    }
  }
}
